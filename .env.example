# ============================================================
# 部署密钥（务必替换！禁止提交到 Git）
# ============================================================

# PostgreSQL 管理员密码（至少 16 位）
POSTGRES_PASSWORD=ChangeMeSuperSecret1234567890

# JWT 签名密钥（48+ 字节随机）
# 生成：openssl rand -base64 48
JWT_SECRET=ChangeThisJwtSecretKeyMakeSureItIsRandomAndLongEnoughForProd12345

# Supabase API Key（32+ 字节随机）
SUPABASE_ANON_KEY=ChangeThisAnonKeyMakeSureItIsRandom1234567890abcdef
SUPABASE_SERVICE_ROLE_KEY=ChangeThisServiceRoleKeyMakeSureItIsVeryLongAndRandom1234567890abcdef

# 部署服务器上的前端访问地址
# 例：http://192.168.1.100:8080
SITE_URL=http://127.0.0.1:8080
