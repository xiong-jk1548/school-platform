# ============================================================
# Supabase 自托管 —— 环境变量模板
# 部署前：复制为 .env，然后把下面所有占位值替换为随机生成的强密钥
# ============================================================

# 数据库密码（至少 16 位，大小写+数字+符号混合）
POSTGRES_PASSWORD=replace-me-with-a-strong-password-at-least-16-chars

# 站点对外访问地址（内网部署时填内网 IP，如 http://192.168.1.100:8000）
SITE_URL=http://127.0.0.1:8000

# ----------------------------------------------------------
# Supabase JWT 与密钥 —— 全部用 openssl 或 node 随机生成
# 生成方法（任选其一）：
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ----------------------------------------------------------

# JWT 签名密钥（至少 32 字节随机）
JWT_SECRET=replace-me-with-a-64-char-jwt-secret-generated-by-openssl-rand

# 匿名访问 key（前端浏览器请求用，可公开）
SUPABASE_ANON_KEY=replace-me-with-an-anon-key-generated-by-openssl-rand-base64

# 服务端超级权限 key（绝对不能泄露给前端！）
SUPABASE_SERVICE_ROLE_KEY=replace-me-with-a-service-role-key-generated-by-openssl-rand-base64
